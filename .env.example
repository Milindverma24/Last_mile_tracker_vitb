# ═════════════════════════════════════════════════════════════════════
# GATIMAN PLATFORM COMPLETE ENVIRONMENT CONFIGURATION (.env.example)
# ═════════════════════════════════════════════════════════════════════

# --- APPLICATION & SERVER ---
PORT=8088
APP_BASE_URL=http://localhost:5173

# --- 1. GOOGLE OAUTH 2.0 CREDENTIALS ---
# Generate at: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorized Javascript Origins: http://localhost:5173, http://127.0.0.1:5173
# Authorized Redirect URIs: http://localhost:5173/login, http://localhost:5173/register
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- 2. AUTOMATED EMAIL SMTP CREDENTIALS (GMAIL / SENDGRID / RESEND) ---
# For Gmail: Use Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=notifications@gatiman.in
EMAIL_FROM_NAME=GATIMAN Logistics

# --- 3. RAZORPAY PAYMENT GATEWAY ---
# Generate at: https://dashboard.razorpay.com/ -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# --- 4. JWT SECURITY & DATABASE ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
DATABASE_URL=jdbc:h2:mem:gatiman_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
