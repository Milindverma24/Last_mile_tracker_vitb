# ═════════════════════════════════════════════════════════════════════════════
# GATIMAN FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ═════════════════════════════════════════════════════════════════════════════

# 1. Backend REST API Base URL
VITE_API_URL=http://localhost:8088/api
VITE_API_BASE_URL=http://localhost:8088/api

# 2. WebSocket Telemetry Live Stream
VITE_WS_URL=ws://localhost:8088/ws

# 3. Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 4. Razorpay Payment Gateway Key (Test Mode)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
