# ═════════════════════════════════════════════════════════════════════════════
# GATIMAN PLATFORM — EXAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env to set up local environment:  cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# 1. APPLICATION & SERVER PORTS
# ─────────────────────────────────────────────────────────────────────────────
PORT=8088
APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8088/api

# ─────────────────────────────────────────────────────────────────────────────
# 2. GOOGLE OAUTH 2.0 CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────
# Generate at: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorized JS Origins: http://localhost:5173, http://127.0.0.1:5173
# Authorized Redirect URIs: http://localhost:5173/login, http://localhost:5173/register
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────────────────
# 3. RAZORPAY PAYMENT GATEWAY (TEST / LIVE)
# ─────────────────────────────────────────────────────────────────────────────
# Generate at: https://dashboard.razorpay.com/ -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ─────────────────────────────────────────────────────────────────────────────
# 4. EMAIL DISPATCH & NOTIFICATIONS (RESEND / BREVO / GMAIL)
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=true

# Option A: Resend (Recommended for Render & cloud deployment)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Option B: Brevo (Sendinblue)
BREVO_API_KEY=xkeysib_your_brevo_api_key
BREVO_SMTP_HOST=smtp-relay.brevo.com

# Option C: Gmail App Password
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Active SMTP Settings
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USERNAME=resend
EMAIL_PASSWORD=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=GATIMAN Logistics

# ─────────────────────────────────────────────────────────────────────────────
# 5. JWT AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ─────────────────────────────────────────────────────────────────────────────
# 6. DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Dev Mode: In-memory H2 (Zero setup required)
# Production (e.g. Render / Neon / Supabase PostgreSQL):
# DATABASE_URL=jdbc:postgresql://ep-xxxx.neon.tech/gatiman_db?sslmode=require
DATABASE_URL=jdbc:h2:mem:gatiman_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
