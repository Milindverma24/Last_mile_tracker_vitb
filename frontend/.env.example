# ═════════════════════════════════════════════════════════════════════
# GATIMAN FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ═════════════════════════════════════════════════════════════════════

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:8088/api

# Google OAuth 2.0 Web Client ID (From Google Cloud Console -> APIs & Services -> Credentials)
# Example: 1234567890-abcdefg12345.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Razorpay Checkout Public Key (Test mode prefix: rzp_test_ / Live mode prefix: rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_gatiman123
